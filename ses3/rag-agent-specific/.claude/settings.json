{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce_source_allowlist.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__corpus__search_corpus|mcp__corpus__get_document|mcp__corpus__list_sources|mcp__corpus__check_staleness|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/audit_evidence_trail.py"
          }
        ]
      }
    ]
  }
}
