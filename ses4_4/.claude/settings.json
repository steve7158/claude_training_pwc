{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce_source_allowlist.py"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__evidence__search_corpus|mcp__evidence__get_document|mcp__evidence__list_sources|mcp__evidence__check_staleness|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/audit_evidence_trail.py"
          }
        ]
      }
    ]
  }
}
