# Copy to .env and fill in. docker-compose.yml passes this file to the
# backend and worker services.

# --- Groq API (free tier) ---
# Leave blank to run with the built-in deterministic mock extractor
# (no external calls) - useful for demos without a key.
# Get a free key at https://console.groq.com
GROQ_API=
GROQ_MODEL=openai/gpt-oss-120b

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Encryption at rest (stand-in for the HSM in the LLD) ---
# Any string works (it's stretched into a Fernet key); use a real generated
# key (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# for anything beyond local dev.
ENCRYPTION_KEY=change-me-to-a-32-byte-fernet-key

# --- Infra (defaults match docker-compose.yml; override for non-compose runs) ---
DATABASE_URL=postgresql+psycopg://carta:carta@postgres:5432/carta
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/documents
